  unit             String                 @db.VarChar(50)
  itemCode         String                 @db.VarChar(100)
  currentStock     Decimal                @default(0) @db.Decimal(10, 2)
  purchasePrice    Decimal                @default(0) @db.Decimal(10, 2)
  status           String                 @default("active") @db.VarChar(50)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  tenant           Tenant                 @relation("TenantStoreItems", fields: [tenantId], references: [id])
  purchaseItems    StorePurchaseItem[]
  stockIssues      StoreStockIssue[]
  returns          StoreReturn[]
  damagedStocks    StoreDamagedStock[]
  stockAdjustments StoreStockAdjustment[]

  @@unique([tenantId, branchId, itemCode], map: "store_items_tenant_branch_item_code_uq")
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([category])
  @@index([status])
  @@map("store_items")
}

model StoreUnit {
