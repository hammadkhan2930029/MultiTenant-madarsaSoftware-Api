model StoreSupplier {
  id           Int                    @id @default(autoincrement())
  tenantId     Int                    @map("tenant_id")
  branchId     Int?                   @map("branch_id")
  supplierName String                 @db.VarChar(150)
  mobileNumber String?                @db.VarChar(50)
  address      String?                @db.VarChar(255)
  shopName     String?                @db.VarChar(150)
  balance      Decimal                @default(0) @db.Decimal(10, 2)
  status       String                 @default("active") @db.VarChar(50)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  tenant       Tenant                 @relation("TenantStoreSuppliers", fields: [tenantId], references: [id])
  purchases    StorePurchase[]
  payments     StoreSupplierPayment[]

  @@unique([tenantId, branchId, supplierName], map: "store_suppliers_tenant_branch_name_uq")
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([status])
  @@map("store_suppliers")
