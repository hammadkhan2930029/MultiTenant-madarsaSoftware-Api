  tenant      Tenant   @relation("TenantStoreUnits", fields: [tenantId], references: [id])

  @@unique([tenantId, branchId, shortName], map: "store_units_tenant_branch_short_name_uq")
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([status])
  @@map("store_units")
}

model StoreCategory {
