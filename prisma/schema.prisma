generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                            Int                          @id @default(autoincrement())
  tenantCode                    String                       @unique
  name                          String
  subdomain                     String?                      @unique
  customDomain                  String?                      @unique
  status                        String                       @default("active")
  branchEnabled                 Boolean                      @default(false) @map("branch_enabled")
  publicWebsiteEnabled          Boolean                      @default(false) @map("public_website_enabled")
  branchLimit                   Int?                         @map("branch_limit")
  ownerAdminId                  Int?
  referralCode                  String                       @unique @map("referral_code") @db.VarChar(20)
  referredByTenantId            Int?                         @map("referred_by_tenant_id")
  referredAt                    DateTime?                    @map("referred_at")
  saleAmount                    Decimal?                     @map("sale_amount") @db.Decimal(12, 2)
  saleCurrency                  String?                      @map("sale_currency") @db.VarChar(10)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  referredBy                    Tenant?                      @relation("TenantReferrals", fields: [referredByTenantId], references: [id], onDelete: SetNull)
  referredTenants               Tenant[]                     @relation("TenantReferrals")
  admins                        Admin[]                      @relation("TenantAdmins")
  roles                         Role[]                       @relation("TenantRoles")
  rolePermissions               RolePermission[]             @relation("TenantRolePermissions")
  roleClassScopes               RoleClassScope[]             @relation("TenantRoleClassScopes")
  roleTeacherClassAssignments   RoleTeacherClassAssignment[] @relation("TenantRoleTeacherClassAssignments")
  profile                       MadrassaProfile?             @relation("TenantMadrassaProfile")
  students                      Student[]                    @relation("TenantStudents")
  studentDocuments              StudentDocument[]            @relation("TenantStudentDocuments")
  parents                       Parent[]                     @relation("TenantParents")
  teachers                      Teacher[]                    @relation("TenantTeachers")
  branches                      Branch[]                     @relation("TenantBranches")
  shifts                        Shift[]                      @relation("TenantShifts")
  departments                   Department[]                 @relation("TenantDepartments")
  qualifications                Qualification[]              @relation("TenantQualifications")
  classes                       AcademicClass[]              @relation("TenantClasses")
  sections                      Section[]                    @relation("TenantSections")
  assignments                   StudentClassAssignment[]     @relation("TenantClassAssignments")
  subjects                      Subject[]                    @relation("TenantSubjects")
  sessions                      AcademicSession[]            @relation("TenantSessions")
  examSchedules                 ExamSchedule[]               @relation("TenantExamSchedules")
  resultGrades                  ResultGrade[]                @relation("TenantResultGrades")
  examResults                   ExamResult[]                 @relation("TenantExamResults")
  examResultSubjects            ExamResultSubject[]          @relation("TenantExamResultSubjects")
  financeHeads                  FinanceHead[]                @relation("TenantFinanceHeads")
  financeExpenseCategories      FinanceExpenseCategory[]     @relation("TenantFinanceExpenseCategories")
  feeVouchers                   StudentFeeVoucher[]          @relation("TenantFeeVouchers")
  fundCollections               FundCollection[]             @relation("TenantFundCollections")
  salaryEntries                 SalaryEntry[]                @relation("TenantSalaryEntries")
  financeTransactions           FinanceTransaction[]         @relation("TenantFinanceTransactions")
  financialRecords              FinancialRecord[]            @relation("TenantFinancialRecords")
  storeItems                    StoreItem[]                  @relation("TenantStoreItems")
  storeUnits                    StoreUnit[]                  @relation("TenantStoreUnits")
  storeCategories               StoreCategory[]              @relation("TenantStoreCategories")
  storeSuppliers                StoreSupplier[]              @relation("TenantStoreSuppliers")
  storeSupplierPays             StoreSupplierPayment[]       @relation("TenantStoreSupplierPayments")
  storePurchases                StorePurchase[]              @relation("TenantStorePurchases")
  storePurchaseItems            StorePurchaseItem[]          @relation("TenantStorePurchaseItems")
  storeStockIssues              StoreStockIssue[]            @relation("TenantStoreStockIssues")
  storeReturns                  StoreReturn[]                @relation("TenantStoreReturns")
  storeDamagedStocks            StoreDamagedStock[]          @relation("TenantStoreDamagedStocks")
  storeApprovalLogs             StoreApprovalLog[]           @relation("TenantStoreApprovalLogs")
  storeAdjustments              StoreStockAdjustment[]       @relation("TenantStoreStockAdjustments")
  hifzDailyEntries              HifzDailyEntry[]             @relation("TenantHifzDailyEntries")
  hifzWeeklyEntries             HifzWeeklyEntry[]            @relation("TenantHifzWeeklyEntries")
  hifzMonthlyEntries            HifzMonthlyEntry[]           @relation("TenantHifzMonthlyEntries")
  hifzSiparaEntries             HifzSiparaEntry[]            @relation("TenantHifzSiparaEntries")
  suggestions                   Suggestion[]                 @relation("TenantSuggestions")
  supportRequests               SupportRequest[]             @relation("TenantSupportRequests")
  studentSchedules              StudentSchedule[]            @relation("TenantStudentSchedules")
  teacherSchedules              TeacherSchedule[]            @relation("TenantTeacherSchedules")
  studentParents                StudentParent[]              @relation("TenantStudentParents")
  studentAttendances            StudentAttendance[]          @relation("TenantStudentAttendances")
  teacherAttendances            TeacherAttendance[]          @relation("TenantTeacherAttendances")
  salaryIncrements              TeacherSalaryIncrement[]     @relation("TenantTeacherSalaryIncrements")
  departmentHeads               DepartmentHeadAssignment[]
  teacherResponsibilities       TeacherResponsibility[]      @relation("TenantTeacherResponsibilities")
  teacherAssignments            TeacherAssignment[]          @relation("TenantTeacherAssignments")
  cities                        City[]                       @relation("TenantCities")
  affiliateCommissionsEarned    AffiliateCommission[]        @relation("AffiliateCommissionReferrer")
  affiliateCommissionsGenerated AffiliateCommission[]        @relation("AffiliateCommissionReferred")
  affiliatePaymentAccounts      AffiliatePaymentAccount[]    @relation("TenantAffiliatePaymentAccounts")
  affiliateWithdrawalRequests   AffiliateWithdrawalRequest[] @relation("TenantAffiliateWithdrawalRequests")
  affiliatePayments             AffiliatePayment[]           @relation("TenantAffiliatePayments")

  @@index([referredByTenantId])
  @@map("tenant")
}

model Admin {
  id                              Int                          @id @default(autoincrement())
  name                            String                       @db.VarChar(150)
  email                           String                       @db.VarChar(150)
  phone                           String?                      @db.VarChar(50)
  city                            String?                      @db.VarChar(150)
  province                        String?                      @db.VarChar(150)
  username                        String                       @db.VarChar(100)
  password                        String                       @db.VarChar(255)
  role                            String                       @default("admin") @db.VarChar(50)
  tenantId                        Int?                         @map("tenant_id")
  roleId                          Int?                         @map("role_id")
  ownerAdminId                    Int?                         @map("owner_admin_id")
  branchId                        Int?                         @map("branch_id")
  teacherId                       Int?                         @unique @map("teacher_id")
  status                          String                       @default("active") @db.VarChar(50)
  createdAt                       DateTime                     @default(now())
  updatedAt                       DateTime                     @updatedAt
  tenant                          Tenant?                      @relation("TenantAdmins", fields: [tenantId], references: [id], onDelete: SetNull)
  assignedRole                    Role?                        @relation("AdminAssignedRole", fields: [roleId], references: [id], onDelete: SetNull)
  assignedBranch                  Branch?                      @relation("AdminBranchAssignment", fields: [branchId], references: [id], onDelete: SetNull)
  linkedTeacher                   Teacher?                     @relation("TeacherLinkedUser", fields: [teacherId], references: [id], onDelete: SetNull)
  ownerAdmin                      Admin?                       @relation("AdminMadrassaOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  ownedUsers                      Admin[]                      @relation("AdminMadrassaOwner")
  createdBranches                 Branch[]                     @relation("BranchCreatedBy")
  createdRoles                    Role[]                       @relation("RoleCreatedBy")
  updatedRoles                    Role[]                       @relation("RoleUpdatedBy")
  madrassaProfile                 MadrassaProfile?
  financialRecords                FinancialRecord[]
  suggestions                     Suggestion[]
  supportRequests                 SupportRequest[]
  salaryIncrements                TeacherSalaryIncrement[]
  auditLogs                       AuditLog[]                   @relation("AdminAuditLogs")
  createdTeacherResponsibilities  TeacherResponsibility[]      @relation("TeacherResponsibilityCreatedBy")
  createdTeacherAssignments       TeacherAssignment[]          @relation("TeacherAssignmentCreatedBy")
  createdAffiliateCommissionTiers AffiliateCommissionTier[]    @relation("AffiliateCommissionTierCreatedBy")
  updatedAffiliateCommissionTiers AffiliateCommissionTier[]    @relation("AffiliateCommissionTierUpdatedBy")
  createdAffiliateSettings        AffiliateSetting[]           @relation("AffiliateSettingCreatedBy")
  updatedAffiliateSettings        AffiliateSetting[]           @relation("AffiliateSettingUpdatedBy")
  createdAffiliatePaymentAccounts AffiliatePaymentAccount[]    @relation("AffiliatePaymentAccountCreatedBy")
  requestedAffiliateWithdrawals   AffiliateWithdrawalRequest[] @relation("AffiliateWithdrawalRequestedBy")
  reviewedAffiliateWithdrawals    AffiliateWithdrawalRequest[] @relation("AffiliateWithdrawalReviewedBy")
  paidAffiliatePayments           AffiliatePayment[]           @relation("AffiliatePaymentPaidBy")

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([roleId])
  @@index([ownerAdminId])
  @@map("admins")
}

model AffiliateCommissionTier {
  id               Int                   @id @default(autoincrement())
  minReferrals     Int                   @map("min_referrals")
  maxReferrals     Int?                  @map("max_referrals")
  percentage       Decimal               @db.Decimal(5, 2)
  effectiveFrom    DateTime              @map("effective_from") @db.Date
  effectiveTo      DateTime?             @map("effective_to") @db.Date
  status           String                @default("active") @db.VarChar(50)
  createdByAdminId Int?                  @map("created_by_admin_id")
  updatedByAdminId Int?                  @map("updated_by_admin_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  creator          Admin?                @relation("AffiliateCommissionTierCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updater          Admin?                @relation("AffiliateCommissionTierUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  commissions      AffiliateCommission[]

  @@index([status, effectiveFrom, effectiveTo], map: "aff_tier_status_dates_idx")
  @@index([minReferrals, maxReferrals], map: "aff_tier_referral_range_idx")
  @@index([createdByAdminId], map: "aff_tier_created_by_idx")
  @@index([updatedByAdminId], map: "aff_tier_updated_by_idx")
  @@map("affiliate_commission_tiers")
}

model AffiliateCommission {
  id                    Int                      @id @default(autoincrement())
  referrerTenantId      Int                      @map("referrer_tenant_id")
  referredTenantId      Int                      @unique @map("referred_tenant_id")
  commissionTierId      Int?                     @map("commission_tier_id")
  referralCountSnapshot Int                      @map("referral_count_snapshot")
  saleAmountSnapshot    Decimal?                 @map("sale_amount_snapshot") @db.Decimal(12, 2)
  percentageSnapshot    Decimal?                 @map("percentage_snapshot") @db.Decimal(5, 2)
  commissionAmount      Decimal?                 @map("commission_amount") @db.Decimal(12, 2)
  currency              String?                  @db.VarChar(10)
  status                String                   @default("pending_calculation") @db.VarChar(50)
  earnedAt              DateTime?                @map("earned_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  referrerTenant        Tenant                   @relation("AffiliateCommissionReferrer", fields: [referrerTenantId], references: [id], onDelete: Restrict, map: "aff_comm_referrer_tenant_fkey")
  referredTenant        Tenant                   @relation("AffiliateCommissionReferred", fields: [referredTenantId], references: [id], onDelete: Restrict, map: "aff_comm_referred_tenant_fkey")
  commissionTier        AffiliateCommissionTier? @relation(fields: [commissionTierId], references: [id], onDelete: SetNull, map: "aff_comm_tier_fkey")

  @@index([referrerTenantId, status], map: "aff_comm_referrer_status_idx")
  @@index([commissionTierId], map: "aff_comm_tier_idx")
  @@index([earnedAt], map: "aff_comm_earned_at_idx")
  @@map("affiliate_commissions")
}

model AffiliatePaymentAccount {
  id                 Int                          @id @default(autoincrement())
  tenantId           Int                          @map("tenant_id")
  accountType        String                       @map("account_type") @db.VarChar(50)
  accountTitle       String                       @map("account_title") @db.VarChar(150)
  institutionName    String?                      @map("institution_name") @db.VarChar(150)
  accountNumber      String?                      @map("account_number") @db.VarChar(100)
  iban               String?                      @db.VarChar(100)
  walletPhone        String?                      @map("wallet_phone") @db.VarChar(50)
  branchName         String?                      @map("branch_name") @db.VarChar(150)
  instructions       String?                      @db.VarChar(500)
  isDefault          Boolean                      @default(false) @map("is_default")
  status             String                       @default("active") @db.VarChar(50)
  createdByAdminId   Int?                         @map("created_by_admin_id")
  createdAt          DateTime                     @default(now()) @map("created_at")
  updatedAt          DateTime                     @updatedAt @map("updated_at")
  tenant             Tenant                       @relation("TenantAffiliatePaymentAccounts", fields: [tenantId], references: [id], onDelete: Restrict, map: "aff_pay_account_tenant_fkey")
  creator            Admin?                       @relation("AffiliatePaymentAccountCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull, map: "aff_pay_account_creator_fkey")
  withdrawalRequests AffiliateWithdrawalRequest[]

  @@index([tenantId, status], map: "aff_pay_account_tenant_status_idx")
  @@index([tenantId, isDefault], map: "aff_pay_account_default_idx")
  @@index([createdByAdminId], map: "aff_pay_account_created_by_idx")
  @@map("affiliate_payment_accounts")
}

model AffiliateWithdrawalRequest {
  id                     Int                      @id @default(autoincrement())
  tenantId               Int                      @map("tenant_id")
  requestedAmount        Decimal                  @map("requested_amount") @db.Decimal(12, 2)
  currency               String                   @db.VarChar(10)
  paymentAccountId       Int?                     @map("payment_account_id")
  paymentAccountSnapshot Json                     @map("payment_account_snapshot")
  status                 String                   @default("pending") @db.VarChar(50)
  requestNote            String?                  @map("request_note") @db.VarChar(500)
  adminNote              String?                  @map("admin_note") @db.VarChar(500)
  requestedByAdminId     Int?                     @map("requested_by_admin_id")
  reviewedByAdminId      Int?                     @map("reviewed_by_admin_id")
  requestedAt            DateTime                 @default(now()) @map("requested_at")
  reviewedAt             DateTime?                @map("reviewed_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  tenant                 Tenant                   @relation("TenantAffiliateWithdrawalRequests", fields: [tenantId], references: [id], onDelete: Restrict, map: "aff_withdraw_tenant_fkey")
  paymentAccount         AffiliatePaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: SetNull, map: "aff_withdraw_account_fkey")
  requester              Admin?                   @relation("AffiliateWithdrawalRequestedBy", fields: [requestedByAdminId], references: [id], onDelete: SetNull, map: "aff_withdraw_requester_fkey")
  reviewer               Admin?                   @relation("AffiliateWithdrawalReviewedBy", fields: [reviewedByAdminId], references: [id], onDelete: SetNull, map: "aff_withdraw_reviewer_fkey")
  payment                AffiliatePayment?

  @@index([tenantId, status, requestedAt], map: "aff_withdraw_tenant_status_date_idx")
  @@index([paymentAccountId], map: "aff_withdraw_account_idx")
  @@index([requestedByAdminId], map: "aff_withdraw_requested_by_idx")
  @@index([reviewedByAdminId], map: "aff_withdraw_reviewed_by_idx")
  @@map("affiliate_withdrawal_requests")
}

model AffiliatePayment {
  id                   Int                        @id @default(autoincrement())
  tenantId             Int                        @map("tenant_id")
  withdrawalRequestId  Int                        @unique @map("withdrawal_request_id")
  amount               Decimal                    @db.Decimal(12, 2)
  currency             String                     @db.VarChar(10)
  paymentMethod        String?                    @map("payment_method") @db.VarChar(100)
  transactionReference String?                    @map("transaction_reference") @db.VarChar(150)
  paymentDate          DateTime                   @map("payment_date") @db.Date
  note                 String?                    @db.VarChar(500)
  paidByAdminId        Int?                       @map("paid_by_admin_id")
  status               String                     @default("paid") @db.VarChar(50)
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")
  tenant               Tenant                     @relation("TenantAffiliatePayments", fields: [tenantId], references: [id], onDelete: Restrict, map: "aff_payment_tenant_fkey")
  withdrawalRequest    AffiliateWithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict, map: "aff_payment_withdrawal_fkey")
  paidBy               Admin?                     @relation("AffiliatePaymentPaidBy", fields: [paidByAdminId], references: [id], onDelete: SetNull, map: "aff_payment_paid_by_fkey")

  @@index([tenantId, status, paymentDate], map: "aff_payment_tenant_status_date_idx")
  @@index([paidByAdminId], map: "aff_payment_paid_by_idx")
  @@map("affiliate_payments")
}

model AffiliateSetting {
  id                         Int      @id @default(autoincrement())
  scopeKey                   String   @unique @default("global") @map("scope_key") @db.VarChar(30)
  withdrawalIntervalDays     Int      @default(0) @map("withdrawal_interval_days")
  allowBlankWithdrawalAmount Boolean  @default(true) @map("allow_blank_withdrawal_amount")
  allowOnlyOnePendingRequest Boolean  @default(true) @map("allow_only_one_pending_request")
  minimumWithdrawalAmount    Decimal? @map("minimum_withdrawal_amount") @db.Decimal(12, 2)
  status                     String   @default("active") @db.VarChar(50)
  createdByAdminId           Int?     @map("created_by_admin_id")
  updatedByAdminId           Int?     @map("updated_by_admin_id")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")
  creator                    Admin?   @relation("AffiliateSettingCreatedBy", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updater                    Admin?   @relation("AffiliateSettingUpdatedBy", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@index([status], map: "aff_setting_status_idx")
  @@index([createdByAdminId], map: "aff_setting_created_by_idx")
  @@index([updatedByAdminId], map: "aff_setting_updated_by_idx")
  @@map("affiliate_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  tenantId    Int?     @map("tenant_id")
  actorUserId Int?     @map("actor_user_id")
  branchId    Int?     @map("branch_id")
  roleId      Int?     @map("role_id")
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(100)
  targetType  String   @map("target_type") @db.VarChar(100)
  targetId    Int?     @map("target_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address") @db.VarChar(100)
  userAgent   String?  @map("user_agent") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  actor       Admin?   @relation("AdminAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([branchId])
  @@index([roleId])
  @@index([tenantId, branchId])
  @@index([module, action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Role {
  id                      Int                          @id @default(autoincrement())
  tenantId                Int?                         @map("tenant_id")
  branchId                Int?                         @map("branch_id")
  roleScopeKey            Int                          @default(0) @map("role_scope_key")
  roleName                String                       @map("role_name") @db.VarChar(100)
  description             String?                      @db.VarChar(255)
  status                  String                       @default("active") @db.VarChar(50)
  isSystemRole            Boolean                      @default(false) @map("is_system_role")
  classScopeMode          String                       @default("all") @map("class_scope_mode") @db.VarChar(20)
  createdBy               Int?                         @map("created_by")
  updatedBy               Int?                         @map("updated_by")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  tenant                  Tenant?                      @relation("TenantRoles", fields: [tenantId], references: [id], onDelete: Cascade)
  branch                  Branch?                      @relation("BranchRoles", fields: [branchId], references: [id], onDelete: SetNull)
  creator                 Admin?                       @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater                 Admin?                       @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  admins                  Admin[]                      @relation("AdminAssignedRole")
  rolePermissions         RolePermission[]
  classScopes             RoleClassScope[]
  teacherClassAssignments RoleTeacherClassAssignment[]

  @@unique([tenantId, roleScopeKey, roleName])
  @@index([tenantId])
  @@index([branchId])
  @@index([tenantId, branchId])
  @@index([status])
  @@index([isSystemRole])
  @@index([createdBy])
  @@index([updatedBy])
  @@map("roles")
}

model Permission {
  id              Int              @id @default(autoincrement())
  permissionKey   String           @unique @map("permission_key") @db.VarChar(150)
  permissionName  String           @map("permission_name") @db.VarChar(150)
  displayLabel    String?          @map("display_label") @db.VarChar(150)
  description     String?          @db.VarChar(255)
  pagePath        String?          @map("page_path") @db.VarChar(255)
  moduleName      String           @map("module_name") @db.VarChar(100)
  action          String?          @db.VarChar(50)
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@index([moduleName])
  @@index([moduleName, action])
  @@map("permissions")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  tenantId     Int?       @map("tenant_id")
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  tenant       Tenant?    @relation("TenantRolePermissions", fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RoleClassScope {
  id        Int           @id @default(autoincrement())
  tenantId  Int           @map("tenant_id")
  branchId  Int           @map("branch_id")
  roleId    Int           @map("role_id")
  classId   Int           @map("class_id")
  createdAt DateTime      @default(now()) @map("created_at")
  tenant    Tenant        @relation("TenantRoleClassScopes", fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch        @relation("BranchRoleClassScopes", fields: [branchId], references: [id], onDelete: Cascade)
  role      Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  class     AcademicClass @relation("AcademicClassRoleScopes", fields: [classId], references: [id], onDelete: Cascade)

  @@unique([roleId, classId])
  @@index([tenantId, branchId])
  @@index([classId])
  @@map("role_class_scopes")
}

model RoleTeacherClassAssignment {
  id        Int           @id @default(autoincrement())
  tenantId  Int           @map("tenant_id")
  branchId  Int           @map("branch_id")
  roleId    Int           @map("role_id")
  teacherId Int           @map("teacher_id")
  classId   Int           @map("class_id")
  createdAt DateTime      @default(now()) @map("created_at")
  tenant    Tenant        @relation("TenantRoleTeacherClassAssignments", fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch        @relation("BranchRoleTeacherClassAssignments", fields: [branchId], references: [id], onDelete: Cascade)
  role      Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  teacher   Teacher       @relation("TeacherRoleClassAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  class     AcademicClass @relation("ClassRoleTeacherAssignments", fields: [classId], references: [id], onDelete: Cascade)

  @@unique([roleId, classId])
  @@index([tenantId, branchId])
  @@index([teacherId])
  @@index([classId])
  @@map("role_teacher_class_assignments")
}

model MadrassaProfile {
  id          Int      @id @default(autoincrement())
  adminId     Int      @unique
  tenantId    Int      @unique @map("tenant_id")
  name        String   @db.VarChar(150)
  email       String   @db.VarChar(150)
  phone1      String?  @db.VarChar(50)
  phone2      String?  @db.VarChar(50)
  address     String?  @db.VarChar(255)
  branch      String?  @db.VarChar(150)
  city        String?  @db.VarChar(150)
