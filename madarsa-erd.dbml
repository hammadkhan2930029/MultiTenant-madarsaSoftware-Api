  `paidAmount` decimal
  `dueAmount` decimal
  `dueDate` datetime [null]
  `paidDate` datetime [null]
  `paymentMethod` varchar [null]
  `remarks` varchar [null]
  `status` varchar
  `createdAt` datetime
  `updatedAt` datetime

  indexes {
    (`tenant_id`, `voucherNo`) [unique]
    (`studentId`, `feeMonth`, `feeYear`) [unique]
  }
}

Table `fund_collections` {
