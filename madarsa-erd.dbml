Table `tenant` {
  `id` int [pk, increment]
  `tenantCode` varchar [unique]
  `name` varchar
  `subdomain` varchar [unique, null]
  `customDomain` varchar [unique, null]
  `status` varchar
  `branch_enabled` boolean
  `public_website_enabled` boolean
  `branch_limit` int [null]
  `ownerAdminId` int [null]
  `referral_code` varchar [unique]
  `referred_by_tenant_id` int [null]
  `referred_at` datetime [null]
  `sale_amount` decimal [null]
  `sale_currency` varchar [null]
  `createdAt` datetime
  `updatedAt` datetime
}

Table `admins` {
  `id` int [pk, increment]
  `name` varchar
  `email` varchar
  `phone` varchar [null]
  `city` varchar [null]
  `province` varchar [null]
  `username` varchar
  `password` varchar
  `role` varchar
  `tenant_id` int [null]
  `role_id` int [null]
  `owner_admin_id` int [null]
  `branch_id` int [null]
  `teacher_id` int [unique, null]
  `status` varchar
  `createdAt` datetime
  `updatedAt` datetime

  indexes {
    (`tenant_id`, `email`) [unique]
    (`tenant_id`, `username`) [unique]
  }
}

Table `affiliate_commission_tiers` {
  `id` int [pk, increment]
  `min_referrals` int
  `max_referrals` int [null]
  `percentage` decimal
  `effective_from` datetime
  `effective_to` datetime [null]
  `status` varchar
  `created_by_admin_id` int [null]
  `updated_by_admin_id` int [null]
  `created_at` datetime
  `updated_at` datetime
}

Table `affiliate_commissions` {
  `id` int [pk, increment]
  `referrer_tenant_id` int
  `referred_tenant_id` int [unique]
  `commission_tier_id` int [null]
  `referral_count_snapshot` int
  `sale_amount_snapshot` decimal [null]
  `percentage_snapshot` decimal [null]
  `commission_amount` decimal [null]
  `currency` varchar [null]
  `status` varchar
  `earned_at` datetime [null]
  `created_at` datetime
  `updated_at` datetime
}

Table `affiliate_payment_accounts` {
  `id` int [pk, increment]
  `tenant_id` int
  `account_type` varchar
  `account_title` varchar
  `institution_name` varchar [null]
  `account_number` varchar [null]
  `iban` varchar [null]
  `wallet_phone` varchar [null]
  `branch_name` varchar [null]
  `instructions` varchar [null]
  `is_default` boolean
  `status` varchar
  `created_by_admin_id` int [null]
  `created_at` datetime
  `updated_at` datetime
}

Table `affiliate_withdrawal_requests` {
  `id` int [pk, increment]
  `tenant_id` int
  `requested_amount` decimal
  `currency` varchar
  `payment_account_id` int [null]
  `payment_account_snapshot` json
  `status` varchar
  `request_note` varchar [null]
  `admin_note` varchar [null]
  `requested_by_admin_id` int [null]
  `reviewed_by_admin_id` int [null]
  `requested_at` datetime
  `reviewed_at` datetime [null]
  `created_at` datetime
  `updated_at` datetime
}

Table `affiliate_payments` {
  `id` int [pk, increment]
  `tenant_id` int
  `withdrawal_request_id` int [unique]
  `amount` decimal
  `currency` varchar
  `payment_method` varchar [null]
  `transaction_reference` varchar [null]
  `payment_date` datetime
  `note` varchar [null]
  `paid_by_admin_id` int [null]
  `status` varchar
  `created_at` datetime
  `updated_at` datetime
}

Table `affiliate_settings` {
  `id` int [pk, increment]
  `scope_key` varchar [unique]
  `withdrawal_interval_days` int
  `allow_blank_withdrawal_amount` boolean
  `allow_only_one_pending_request` boolean
  `minimum_withdrawal_amount` decimal [null]
  `status` varchar
  `created_by_admin_id` int [null]
  `updated_by_admin_id` int [null]
  `created_at` datetime
  `updated_at` datetime
}

Table `audit_logs` {
  `id` int [pk, increment]
  `tenant_id` int [null]
  `actor_user_id` int [null]
  `branch_id` int [null]
  `role_id` int [null]
  `action` varchar
  `module` varchar
  `target_type` varchar
  `target_id` int [null]
  `old_value` json [null]
  `new_value` json [null]
  `ip_address` varchar [null]
  `user_agent` varchar [null]
  `created_at` datetime
}

Table `roles` {
  `id` int [pk, increment]
  `tenant_id` int [null]
  `branch_id` int [null]
  `role_scope_key` int
  `role_name` varchar
  `description` varchar [null]
  `status` varchar
