{
  "name": "madarsa-backend-server",
  "version": "1.0.0",
  "description": "Backend server for Madarsa Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:managed": "node scripts/supervise-server.js",
    "health:check": "node scripts/check-health.js",
    "postinstall": "prisma generate",
    "seed": "node scripts/seed.js",
    "seed:permissions": "node scripts/seed-permissions.js",
    "tenant:default": "node scripts/ensure-default-tenant.js",
    "test:tenants": "node scripts/test-two-tenants.js",
    "test:roles": "node scripts/test-role-crud.js",
    "test:permissions": "node scripts/test-permissions-api.js",
    "test:users": "node scripts/test-user-crud.js",
    "test:authz": "node scripts/test-authorization-middleware.js",
    "test:branch-edges": "node scripts/test-branch-edge-cases.js",
    "test:branch-security": "node scripts/test-branch-security-suite.js",
    "test:finance-reconciliation": "node scripts/test-financial-branch-reconciliation.js",
    "test:branch-performance": "node scripts/test-branch-performance-audit.js",
    "test:branch-api-errors": "node scripts/test-branch-api-errors.js",
    "test:branch-role-isolation": "node scripts/test-branch-role-isolation.js",
    "test:login-rbac": "node scripts/test-login-rbac-response.js",
    "test:audit-logs": "node scripts/test-rbac-audit-logs.js",
    "test:affiliate": "node scripts/test-affiliate-suite.js",
    "test:affiliate-http-security": "node scripts/test-affiliate-http-security.js",
    "test:affiliate-role-boundaries": "node scripts/test-affiliate-role-boundaries.js",
    "test:affiliate-write-boundaries": "node scripts/test-affiliate-write-boundaries.js",
    "test:affiliate-commission-model": "node scripts/test-affiliate-commission-model.js",
    "test:affiliate-withdrawal-rules": "node scripts/test-affiliate-withdrawal-rules.js",
    "check:affiliate-deployment": "node scripts/check-affiliate-deployment.js",
    "verify:affiliate": "npm run check:affiliate-deployment && npm run test:affiliate && npm run test:affiliate-http-security && npm run test:affiliate-role-boundaries && npm run test:affiliate-write-boundaries && npm run test:affiliate-commission-model && npm run test:affiliate-withdrawal-rules",
    "test:rbac-suite": "node scripts/test-rbac-suite.js",
    "smoke:test": "node scripts/smoke-test.js",
    "migrate:branch-role-scope": "node scripts/migrate-branch-role-scope.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.8.2"
  }
}
